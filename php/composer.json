    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "numbertowords",
        "number to words api",
        "number to words converter api",
        "convert number to words",
        "number to words",
        "digits to text"
    ],
    "homepage": "https://apiverve.com/marketplace/numbertowords?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/numbertowords",
        "source": "https://github.com/apiverve/numbertowords-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Numbertowords\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Numbertowords\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
